## Standard Visual Studio / .NET .gitignore

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
msbuild.log
msbuild.err
msbuild.wrn

# Visual Studio cache / options directories
.vs/
.vscode/

# Rider
.idea/
*.sln.iml

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Misc temporary / backup files
*.tmp
*.bak
*.swp
*~
[Dd]esktop.ini
Thumbs.db
.DS_Store

# StyleCop
StyleCopReport.xml

# Local development notes (local only)
claude.local.md

# Local design docs (local only)
.design/

# Local research docs (local only)
.research/

# Local plan docs (local only)
.plan/

# Verify snapshot testing scratch output
*.received.*

# BenchmarkDotNet output
BenchmarkDotNet.Artifacts/
