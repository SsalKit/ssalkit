<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SsalKit.Timekeeping</PackageId>
    <Description>Deterministic, serializable time-state calculations: calendar recurrence boundaries (daily/weekly/monthly) and half-open time-window arithmetic over TimeProvider. Pure functions of (state, instant) -- never reads the clock. The daylight-saving resolution rules are a fixed versioned contract. Zero dependencies.</Description>
    <PackageDescription>$(Description)</PackageDescription>
    <PackageTags>timekeeping;recurrence;schedule;reset;time-window;deterministic;timezone;dst;timeprovider</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SsalKit.Timekeeping.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Agent-facing contract sheet, shipped alongside the human README. -->
    <None Include="AI.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
