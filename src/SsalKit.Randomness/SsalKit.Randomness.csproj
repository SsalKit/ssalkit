<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SsalKit.Randomness</PackageId>
    <Description>Deterministic, state-serializable PRNG (xoshiro256** + SplitMix64) with a unified random-source abstraction and weighted-random sampling. Zero dependencies.</Description>
    <PackageDescription>Deterministic, state-serializable PRNG (xoshiro256** + SplitMix64) with a unified random-source abstraction and weighted-random sampling. Zero dependencies.</PackageDescription>
    <PackageTags>random;prng;deterministic;xoshiro;weighted-random;seedable;game</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SsalKit.Randomness.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-order dependency only: the generator must not be added as a compile-time
         reference or analyzer for this project itself. -->
    <ProjectReference Include="..\SsalKit.Randomness.Generator\SsalKit.Randomness.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the generator assembly inside this package under analyzers/dotnet/cs so
         consumers automatically get the source generator when they reference this package.
         This is not a package dependency, so the "zero dependencies" contract still holds. -->
    <None Include="..\SsalKit.Randomness.Generator\bin\$(Configuration)\netstandard2.0\SsalKit.Randomness.Generator.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
