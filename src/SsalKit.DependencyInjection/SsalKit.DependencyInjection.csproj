<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SsalKit.DependencyInjection</PackageId>
    <Description>Compile-time DI auto-registration for .NET via a Roslyn source generator. Zero reflection, no assembly scanning, AOT/trimming friendly.</Description>
    <PackageDescription>Compile-time DI auto-registration for .NET via a Roslyn source generator. Zero reflection, no assembly scanning, AOT/trimming friendly.</PackageDescription>
    <PackageTags>di;dependency-injection;source-generator;aot;trimming;ioc;servicecollection</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-order dependency only: the generator must not be added as a compile-time
         reference or analyzer for this project itself. -->
    <ProjectReference Include="..\SsalKit.DependencyInjection.Generator\SsalKit.DependencyInjection.Generator.csproj"
                       ReferenceOutputAssembly="false"
                       PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the generator assembly inside this package under analyzers/dotnet/cs so
         consumers automatically get the source generator when they reference this package. -->
    <None Include="..\SsalKit.DependencyInjection.Generator\bin\$(Configuration)\netstandard2.0\SsalKit.DependencyInjection.Generator.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
