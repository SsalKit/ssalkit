<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SsalKit.StableHashing</PackageId>
    <Description>Platform- and process-independent 64-bit checksums via a version-locked canonical encoding contract (XxHash64). Zero dependencies.</Description>
    <PackageDescription>Platform- and process-independent 64-bit checksums via a version-locked canonical encoding contract (XxHash64). Zero dependencies.</PackageDescription>
    <PackageTags>stable-hash;checksum;xxhash;deterministic;fingerprint;source-generator;aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SsalKit.StableHashing.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-order dependency only: the generator must not be added as a compile-time
         reference or analyzer for this project itself. -->
    <ProjectReference Include="..\SsalKit.StableHashing.Generator\SsalKit.StableHashing.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the generator assembly inside this package under analyzers/dotnet/cs so
         consumers automatically get the source generator when they reference this package.
         This is not a package dependency, so the "zero dependencies" contract still holds. -->
    <None Include="..\SsalKit.StableHashing.Generator\bin\$(Configuration)\netstandard2.0\SsalKit.StableHashing.Generator.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
